# Aplicación
NODE_ENV=development
PORT=3000
APP_NAME=TechBrain API
FRONTEND_URL=http://localhost:4500
CORS_ORIGINS=http://localhost:3000,http://localhost:4500
LOG_LEVEL=debug

# Observabilidad
SENTRY_DSN=
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/techbrain?schema=public

# Autenticación
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

DISCORD_CLIENT_ID=replace-me
DISCORD_CLIENT_SECRET=replace-me
DISCORD_CALLBACK_URL=http://localhost:3000/api/auth/discord/callback
DISCORD_GUILD_ID=1130900724499365958
DISCORD_REQUIRE_GUILD_MEMBERSHIP=false
