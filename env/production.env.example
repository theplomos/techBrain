# Copia este archivo como env/production.env y reemplaza todos los CHANGE_ME.

# Docker Compose
COMPOSE_PROJECT_NAME=techbrain-production
CONTAINER_NAME_PREFIX=techbrain-production
BACKEND_IMAGE_NAME=techbrain-backend
MIGRATIONS_IMAGE_NAME=techbrain-migrations
IMAGE_TAG=latest

# PostgreSQL
POSTGRES_IMAGE=postgres:17.2
POSTGRES_PORT=5432
POSTGRES_VOLUME_NAME=techbrain-postgres-production
POSTGRES_USER=techbrain
POSTGRES_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
POSTGRES_DB=techbrain
DATABASE_URL=postgresql://techbrain:CHANGE_ME_DATABASE_PASSWORD@postgres:5432/techbrain?schema=public

# Aplicación
NODE_ENV=production
PORT=3000
APP_NAME=TechBrain API
FRONTEND_URL=https://CHANGE_ME_FRONTEND_DOMAIN
CORS_ORIGINS=https://CHANGE_ME_FRONTEND_DOMAIN
LOG_LEVEL=warn

# Observabilidad
SENTRY_DSN=
SENTRY_RELEASE=techbrain@CHANGE_ME_RELEASE
SENTRY_TRACES_SAMPLE_RATE=0.1

# Autenticación
JWT_ACCESS_SECRET=CHANGE_ME_WITH_AT_LEAST_32_RANDOM_CHARACTERS
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Discord OAuth2
DISCORD_CLIENT_ID=CHANGE_ME
DISCORD_CLIENT_SECRET=CHANGE_ME
DISCORD_CALLBACK_URL=https://CHANGE_ME_API_DOMAIN/api/auth/discord/callback
DISCORD_GUILD_ID=1130900724499365958
DISCORD_REQUIRE_GUILD_MEMBERSHIP=true
