# Docker Compose
COMPOSE_PROJECT_NAME=techbrain-dev
CONTAINER_NAME_PREFIX=techbrain-dev
BACKEND_IMAGE_NAME=techbrain-backend
MIGRATIONS_IMAGE_NAME=techbrain-migrations
IMAGE_TAG=dev

# PostgreSQL local
POSTGRES_IMAGE=postgres:17.2
POSTGRES_PORT=5432
POSTGRES_VOLUME_NAME=techbrain-postgres-dev
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=techbrain
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/techbrain?schema=public

# Aplicación
NODE_ENV=development
PORT=3000
APP_NAME=TechBrain API
FRONTEND_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:3001
LOG_LEVEL=debug

# Observabilidad
SENTRY_DSN=https://80dff2347a0b26b3510ef8180643b473@o4512019167903744.ingest.us.sentry.io/4512096427376640
SENTRY_RELEASE=techbrain@dev
SENTRY_TRACES_SAMPLE_RATE=0

# Autenticación
JWT_ACCESS_SECRET=local-development-secret-change-before-deploying
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Discord OAuth2
DISCORD_CLIENT_ID=replace-me
DISCORD_CLIENT_SECRET=replace-me
DISCORD_CALLBACK_URL=http://localhost:3000/api/auth/discord/callback
DISCORD_GUILD_ID=1130900724499365958
DISCORD_REQUIRE_GUILD_MEMBERSHIP=false
